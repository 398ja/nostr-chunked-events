{
  "name": "nostr-chunked-events",
  "version": "0.3.0",
  "description": "Chunked event publishing and fetching for Nostr - handle large content that exceeds relay size limits",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "browser": "dist/index.umd.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "browser": "./dist/index.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nostr",
    "chunked",
    "events",
    "large-content",
    "relay",
    "sync",
    "nip-60",
    "cashu"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "peerDependencies": {
    "nostr-tools": "^2.0.0"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/node": "^22.0.0",
    "@types/pako": "^2.0.3",
    "eslint": "^9.39.5",
    "happy-dom": "^15.11.7",
    "nostr-tools": "^2.10.0",
    "rollup": "^4.0.0",
    "rollup-plugin-dts": "^6.0.0",
    "tslib": "^2.8.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.0.0"
  }
}
